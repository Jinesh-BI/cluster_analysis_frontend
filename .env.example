# Copy to .env.local and adjust for local dev.
# In production this gets baked in at build time (Vite reads it at build,
# not runtime), so set it correctly before `npm run build`.
VITE_API_BASE_URL=http://localhost:8000/plot-analysis/
# VITE_API_BASE_URL=https://ops.bharatintelligence.ai/plot-analysis/

# Base URL for the tender service (api/tenderClient.js) — backs the
# Mukkadam Job Board widget. No auth token needed for this host.
VITE_TENDER_BASE_URL=https://tender.bharatintelligence.ai

# Token for demand.bharatintelligence.ai's presign_obj_api (sent as
# `Authorization: Token <value>`) — used by MukkadamJobImagesDialog to
# resolve a job photo's image_key into a viewable URL. Keep the real
# value in .env.local only, never commit it.
VITE_TENDER_PRESIGN_TOKEN=
